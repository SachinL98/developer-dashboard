generator client {
  provider      = "prisma-client-js"
  // "native" for local work and CI; rhel-openssl-3.0.x is the Vercel (AWS Lambda) runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  BACKLOG
  READY_TO_DEV
  IN_PROGRESS
  INITIAL_REVIEW
  REVIEW
  DEPLOYED_STG
  FAILED_STG
  DOCUMENTED
  DEPLOYED_PROD
  DONE
}

enum TicketType {
  BUG
  FEATURE
  ENHANCEMENT
  TASK
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SprintState {
  PLANNING
  ACTIVE
  CLOSED
}

enum Access {
  DEVELOPER
  LEAD
  ADMIN
}

enum MeetingKind {
  STANDUP
  GROOMING
  ESTIMATION
  SPRINT_PLAN
  WEEKLY_SUMMARY
  DEMO
  OTHER
}

model Developer {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  githubLogin String?  @unique
  jiraAccount String?
  role        String   @default("Developer")
  avatarHue   Int      @default(200)
  theme       String   @default("light") // light | dark | system, remembered per user; light unless they choose otherwise
  capacityHrs Float    @default(30) // productive hours per sprint week
  access      Access   @default(DEVELOPER)
  active      Boolean  @default(true)
  googleSub   String?  @unique
  picture     String?
  lastLoginAt DateTime?
  // Email + password sign-in
  passwordHash        String?
  mustChangePassword  Boolean   @default(false)
  passwordChangedAt   DateTime?
  failedLogins        Int       @default(0)
  lockedUntil         DateTime?
  discordId           String? // Discord user id, for direct messages and mentions
  notifyEmail         Boolean   @default(true)
  notifyDiscord       Boolean   @default(true)
  aiProvider          String? // anthropic | openai | gemini: which saved AI key this person's AI buttons use
  authSessions AuthSession[]
  connections Connection[]
  tickets     Ticket[]       @relation("Assignee")
  sessions    WorkSession[]
  timers      TimeEntry[]
  votes       EstimateVote[]
  transitions Transition[]
  leaves      Leave[]
}

model Project {
  id      String   @id @default(cuid())
  key     String   @unique
  name    String
  repo    String? // org/repo
  color   String   @default("#6ee7ff")
  tickets Ticket[]
}

model Sprint {
  id        String      @id @default(cuid())
  name      String
  goal      String?
  state     SprintState @default(PLANNING)
  startDate DateTime
  endDate   DateTime
  jiraId    String?
  tickets   Ticket[]
  createdAt DateTime    @default(now())
}

model Ticket {
  id           String      @id @default(cuid())
  key          String      @unique
  title        String
  description  String      @default("")
  type         TicketType  @default(TASK)
  priority     Priority    @default(MEDIUM)
  status       Status      @default(BACKLOG)
  rank         Int         @default(0) // backlog / sprint priority order, lower first
  storyPoints  Int?
  estimateHrs  Float? // agreed rough estimate
  progressPct  Int         @default(0) // implementation progress 0-100
  labels       String[]    @default([])
  prUrl        String?
  prNumber     Int?
  prState      String? // open | merged | closed
  jiraKey      String?
  jiraStatus   String? // the real Jira status name, mirrored so the board can show the team's own columns
  estimateSyncedAt  DateTime? // last time the estimate was written to the Jira issue
  estimateSyncError String? // why the last write-back failed, if it did
  complicated  Boolean     @default(false) // flagged for grooming
  dueDate      DateTime? // from Jira's due date, or set here; a ticket past it that is not done is overdue
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  startedAt    DateTime?
  doneAt       DateTime?
  project      Project     @relation(fields: [projectId], references: [id])
  projectId    String
  sprint       Sprint?     @relation(fields: [sprintId], references: [id])
  sprintId     String?
  assignee     Developer?  @relation("Assignee", fields: [assigneeId], references: [id])
  assigneeId   String?
  transitions  Transition[]
  timeEntries  TimeEntry[]
  votes        EstimateVote[]
  reviews      PrReview[]
  progressLogs ProgressLog[]
  actionItems  ActionItem[]

  @@index([status])
  @@index([sprintId])
}

model Transition {
  id        String    @id @default(cuid())
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  from      Status
  to        Status
  at        DateTime  @default(now())
  by        Developer? @relation(fields: [byId], references: [id])
  byId      String?

  @@index([ticketId])
}

// Developer's working day: clock in / clock out
model WorkSession {
  id          String    @id @default(cuid())
  developer   Developer @relation(fields: [developerId], references: [id])
  developerId String
  startedAt   DateTime
  endedAt     DateTime?
  note        String?
  // Start-of-day check-in: tickets planned for today and a free message
  planTicketIds String[] @default([])
  planNote      String?
  // End-of-day check-out: tickets actually worked on and a free message
  doneTicketIds String[] @default([])
  doneNote      String?

  @@index([developerId, startedAt])
}

// Time spent on a ticket (timer)
model TimeEntry {
  id          String    @id @default(cuid())
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId    String
  developer   Developer @relation(fields: [developerId], references: [id])
  developerId String
  startedAt   DateTime
  endedAt     DateTime?
  note        String?

  @@index([ticketId])
  @@index([developerId, startedAt])
}

model ProgressLog {
  id        String   @id @default(cuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  pct       Int
  note      String?
  at        DateTime @default(now())
}

model EstimateVote {
  id          String    @id @default(cuid())
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId    String
  developer   Developer @relation(fields: [developerId], references: [id])
  developerId String
  hours       Float
  createdAt   DateTime  @default(now())

  @@unique([ticketId, developerId])
}

// Claude / manual PR review checklist runs
model PrReview {
  id        String   @id @default(cuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  kind      String // INITIAL_CLAUDE | REVIEWER
  round     Int      @default(1)
  items     Json // [{id,label,severity,checked,note}]
  passed    Boolean  @default(false)
  createdAt DateTime @default(now())
  status    String   @default("DONE") // RUNNING | DONE | ERROR
  source    String? // claude | diff scan | manual
  summary   String?
  findings  Json? // [{severity,title,detail,file,line}]
  model     String?
  error     String?
  truncated Boolean  @default(false) // the PR diff was too large to send in full
  trigger   String? // move | manual | push

  @@index([ticketId])
}

model Meeting {
  id          String      @id @default(cuid())
  kind        MeetingKind
  title       String
  startsAt    DateTime
  endsAt      DateTime
  meetUrl     String?
  googleEvId  String?
  attendees   String[]    @default([])
  transcript  String?
  summary     String?
  decisions   String[]    @default([])
  richNotes   Json? // AI notes: key points, topics, risks, open questions, per-person updates
  durationSec Int? // real length of the call, from Meet or the last timestamp in the transcript
  transcriptSource String? // meet | upload | live | paste
  createdAt   DateTime    @default(now())
  actionItems ActionItem[]
  speakers    MeetingSpeaker[]

  @@index([startsAt])
}

model ActionItem {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String
  text      String
  owner     String?
  done      Boolean  @default(false)
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  ticketId  String?
}

// Login sessions. Only a SHA-256 hash of the cookie token is stored.
model AuthSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  user        Developer @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  userAgent   String?

  @@index([userId])
}

// Per-user OAuth connections (Google Calendar/Meet, Jira Cloud). Tokens are AES-256-GCM encrypted.
model Connection {
  id          String    @id @default(cuid())
  user        Developer @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  provider    String // GOOGLE | JIRA | CLAUDE (accessToken holds the user's own Anthropic API key)
  accessToken String
  refreshToken String?
  expiresAt   DateTime?
  scope       String?
  cloudId     String? // Jira site
  siteUrl     String? // Jira site URL
  externalId  String? // Jira accountId / Google sub
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([userId, provider])
}

/// Small key/value store: cached Jira board config, status-name mapping, last poll time.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Leave requests. Dates are local calendar dates (YYYY-MM-DD) so they don't shift with the timezone.
model Leave {
  id            String    @id @default(cuid())
  developer     Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  developerId   String
  type          String    @default("ANNUAL") // ANNUAL | CASUAL | SICK | UNPAID | OTHER
  startDate     String
  endDate       String
  portion       String    @default("FULL") // FULL | HALF (half applies to a single day)
  reason        String    @default("")
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  googleEventId String?
  createdAt     DateTime  @default(now())

  @@index([developerId])
  @@index([status, startDate, endDate])
}

// Saved Claude analyses: developer profiles and estimate reviews
model AiInsight {
  id          String   @id @default(cuid())
  kind        String // DEV_PROFILE | ESTIMATE
  subjectId   String // developer id or ticket id
  content     Json
  model       String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([kind, subjectId, createdAt])
}

// Self-service sign-up requests. No account exists until an admin approves; the person chose their own password.
model SignupRequest {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  jobTitle     String   @default("Developer")
  githubLogin  String?
  passwordHash String
  createdAt    DateTime @default(now())
}

// Who spoke and for how long in a meeting: the basis of the engagement metrics.
model MeetingSpeaker {
  id          String   @id @default(cuid())
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId   String
  name        String
  developerId String? // matched person, when the speaker's name matches someone in the app
  talkSec     Int
  words       Int
  turns       Int
  estimated   Boolean  @default(false) // true when the transcript had no timestamps and talk time was estimated from words

  @@index([meetingId])
  @@index([developerId])
}

// A spoken name that an admin or lead linked to a person, so future meetings match automatically.
model SpeakerAlias {
  id          String   @id @default(cuid())
  alias       String   @unique // lower-case spoken name, e.g. "nim r"
  developerId String
  createdAt   DateTime @default(now())

  @@index([developerId])
}

// One row per notification decision, so each person gets at most one of each kind per day.
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String // OVERDUE | START_REMINDER | TEST
  dayKey    String // local date, e.g. 2026-11-05
  status    String // sent | failed | skipped
  channels  Json?
  summary   String?
  createdAt DateTime @default(now())

  @@unique([userId, kind, dayKey])
  @@index([createdAt])
}
