# ---- Core ----
DATABASE_URL="postgresql://dash:dash@localhost:5432/devdash"
APP_URL="http://localhost:3000"             # public URL; used to build OAuth redirect URIs
AUTH_SECRET=""                              # 32+ random chars: openssl rand -base64 48 (encrypts stored OAuth tokens). REQUIRED in production
SIGNUP_ENABLED="true"                        # "false" closes the Create an account page (admins add people instead)
ADMIN_EMAILS=""                             # optional: accounts created with these emails get the Admin role
CRON_SECRET=""                              # bearer token for /api/cron/sync and /api/cron/transcripts
TEAM_TIMEZONE="Asia/Colombo"

# ---- Google: Calendar + Meet only (optional; not used for sign-in) (OAuth client of type "Web application") ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID="primary"
# Optional shared fallback: refresh token of a team account, used when the signed-in user hasn't connected Google
GOOGLE_REFRESH_TOKEN=""

# ---- Jira Cloud: per-user OAuth 2.0 (3LO) ----
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""
JIRA_SITE_URL="https://your-team.atlassian.net"   # optional: pick this site if a user has several
JIRA_PROJECT_KEY=""
JIRA_BOARD_ID=""                            # Scrum board id, for sprint create/start/close
JIRA_STORY_POINTS_FIELD="customfield_10016"
JIRA_SPRINT_FIELD="customfield_10020"
JIRA_WEBHOOK_SECRET=""                      # required in production for POST /api/webhooks/jira?secret=...
# Optional service account (basic auth) for cron sync when nobody has connected
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# ---- GitHub ----
GITHUB_TOKEN=""                             # fine-grained token: read pull requests + contents on the org repos
GITHUB_ORG=""
GITHUB_WEBHOOK_SECRET=""                    # required in production for POST /api/webhooks/github

# ---- Optional: AI (every person can add their own key in Settings; these are shared fallbacks) ----
ANTHROPIC_API_KEY=""                        # Claude
OPENAI_API_KEY=""                           # OpenAI
GEMINI_API_KEY=""                           # Google Gemini
# Optional model overrides (defaults: claude-sonnet-5-5, gpt-4o, gemini-2.0-flash)
ANTHROPIC_MODEL=""
OPENAI_MODEL=""
GEMINI_MODEL=""
# Speech-to-text models for in-app meeting recordings (defaults: gpt-4o-transcribe-diarize, and the Gemini model above)
OPENAI_STT_MODEL=""
GEMINI_STT_MODEL=""
# Only for GitHub Enterprise or testing: base URLs of the GitHub and Anthropic APIs
GITHUB_API_URL=""
ANTHROPIC_API_URL=""
OPENAI_API_URL=""
GEMINI_API_URL=""

# ---- Optional: email and Discord alerts (overdue tickets, start-of-day reminders) ----
EMAIL_FROM=""                               # verified sender address
EMAIL_FROM_NAME="SpaceIT Delivery"
ZEPTOMAIL_TOKEN=""                          # ZeptoMail "Send Mail token"
ZEPTOMAIL_URL=""                            # defaults to https://cpaas.zoho.com; set only to use another host, e.g. https://api.zeptomail.eu
ZOHO_SMTP_USER=""                           # or Zoho Mail SMTP: mailbox and app password
ZOHO_SMTP_PASSWORD=""
ZOHO_SMTP_HOST=""                           # default smtp.zoho.com (smtp.zoho.eu, smtp.zoho.in)
DISCORD_BOT_TOKEN=""                        # bot that direct-messages people
DISCORD_WEBHOOK_URL=""                      # or a channel webhook that @mentions people

# Leave, WFH and holidays from the HR app (when set, replaces the local leave tables for capacity)
# HR_API_URL=https://your-hr-api.vercel.app
# HR_API_TOKEN=
# HR_WEB_URL=https://your-hr-web.vercel.app   # where the Leave and Holidays pages link to

# Single sign-on with the HR app: the same SSO_SECRET (32+ characters, openssl rand -hex 32) on both apps.
# With HR_WEB_URL set, the account menu shows "Switch to HR app".
# SSO_SECRET=
