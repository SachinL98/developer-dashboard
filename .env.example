DATABASE_URL="postgresql://dash:dash@localhost:5432/devdash"

# Jira Cloud (optional - the app runs on demo data without these)
JIRA_BASE_URL="https://your-team.atlassian.net"
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY=""
JIRA_BOARD_ID=""
JIRA_STORY_POINTS_FIELD="customfield_10016"

# GitHub (optional)
GITHUB_TOKEN=""
GITHUB_ORG=""

# Google Calendar / Meet (optional, service account or OAuth refresh token)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
TEAM_TIMEZONE="Asia/Colombo"

# Meeting notes AI summaries (optional; heuristic summariser is used when empty)
ANTHROPIC_API_KEY=""
